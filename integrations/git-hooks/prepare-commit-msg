#!/bin/sh
# AHP reminder hook. Appends stripped comment lines to the commit message so an
# agent (or human) does not forget to open/promote the intent for this commit.
# Never blocks. Requires `ahp` on PATH.
#
# Install:  cp integrations/git-hooks/prepare-commit-msg .git/hooks/ && chmod +x .git/hooks/prepare-commit-msg

MSG_FILE="$1"
SOURCE="$2"
case "$SOURCE" in merge|squash) exit 0 ;; esac
command -v ahp >/dev/null 2>&1 || exit 0

OPEN=$(ahp read --type intent.open --json 2>/dev/null | wc -l | tr -d ' ')
DONE=$(ahp read --type intent.promote --json 2>/dev/null | wc -l | tr -d ' ')

{
  echo ""
  echo "# --- AHP reminder (comments are stripped) ---"
  echo "# worklog: ${OPEN:-?} intent.open / ${DONE:-?} intent.promote for this project"
  echo "# - opened an intent for this commit?         ahp intent open --id <id> ..."
  echo "# - after the gate passes:                    ahp intent promote --id <id> --commit <sha> ..."
} >> "$MSG_FILE"

exit 0
